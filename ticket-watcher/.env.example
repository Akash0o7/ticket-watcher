EVENT_URL=https://ticketgenie.in/ticket/india-vs-west-indies-5th-t20i-match-bengaluru-Oct17-2026/
QTY=4
MAX_PRICE=1500
INTERVAL_SECONDS=60
HEADLESS=0

# Link to the live browser (see end of cloud-setup.sh). Tapping an alert opens it so you can solve a captcha.
REMOTE_VIEW_URL=
# How long the script waits for you to solve a captcha or fix a stuck page
HUMAN_WAIT_MINUTES=5

# Pick a long random topic, then subscribe to it in the ntfy phone app
NTFY_TOPIC=change-me-to-a-long-random-string

# Details typed into the checkout form
BUYER_NAME=
BUYER_EMAIL=
BUYER_PHONE=
